def test_list_onts_over_the_package_path_maps_to_legacy_entries(rig_factory) -> None:
    rig = rig_factory({"display ont info 0 2 1 all\n": INVENTORY_REPLY})
    olt = _olt()
    _enable(olt)
    ok, message, entries = get_registered_ont_serials(olt, ["gpon-0/2/1", "0/2/1"])
    assert ok is True
    assert message == "Found 2 registered ONTs on 1 ports"
    assert [(e.fsp, e.onu_id, e.real_serial, e.run_state) for e in entries] == [
        ("0/2/1", 0, "4857544300000001", "online"),
        ("0/2/1", 1, "4857544300000002", "offline"),
    ]
    assert rig.opens == 1
    assert "display ont info 0 2 1 all\n" in rig.channel.sent
    assert rig.quits == 1 and rig.channel.sent.count("y\n") == 1
    assert rig.logouts == ["clean"]
    rig.assert_closed_exactly_once()
    assert rig.reads[-1][1:3] == ("list_onts", "ok")


