# ── legacy-result mapping ────────────────────────────────────────────────────


def test_the_reason_message_map_is_the_callers_compatibility_surface() -> None:
    msg = device_cli_host.unreadable_message
    assert olt_ssh_limiter.is_busy_message(msg(Reason.OLT_BUSY, fsp=None, detail="x"))
    assert olt_ssh_limiter.is_login_failed_message(
        msg(Reason.LOGIN_REFUSED, fsp=None, detail="x")
    )
    assert olt_ssh_limiter.is_auth_rejected_message(
        msg(Reason.AUTH_REJECTED, fsp=None, detail="x")
    )
    for reason in (
        Reason.UNKNOWN_COMMAND,
        Reason.PARAMETER_ERROR,
        Reason.INSUFFICIENT_PRIVILEGE,
        Reason.BOARD_TYPE_ERROR,
    ):
        assert msg(reason, fsp="0/2/1", detail="").startswith("OLT rejected: ")
    assert "could not be parsed" in msg(Reason.ROWS_UNPARSED, fsp="0/2/1", detail="")
    assert "truncated read" in msg(Reason.TRUNCATED, fsp="0/2/1", detail="")
    assert "was not recognized" in msg(
        Reason.UNRECOGNIZED_RESPONSE, fsp="0/2/1", detail=""
    )
    # Every reason produces a non-empty failure, never a success-looking text.
    for reason in Reason:
        assert msg(reason, fsp="0/2/1", detail="d")


# ── end-to-end through the real wrappers (fake device) ───────────────────────

INVENTORY_REPLY = (
    "display ont info 0 2 1 all\r\n"
    "  -----------------------------------------------------------------------------\r\n"
    "  F/S/P   ONT         SN         Control     Run      Config   Match    Protect\r\n"
    "          ID                     flag        state    state    state    side\r\n"
    "  -----------------------------------------------------------------------------\r\n"
    "  0/ 2/1     0  4857544300000001  active      online   normal   match    no \r\n"
    "  0/ 2/1     1  4857544300000002  active      offline  initial  initial  no \r\n"
    "  -----------------------------------------------------------------------------\r\n"
    "  F/S/P   ONT-ID   Description\r\n"
    "  -----------------------------------------------------------------------------\r\n"
    "  0/ 2/1      0   CUSTOMER_01\r\n"
    "  0/ 2/1      1   CUSTOMER_02\r\n"
    "  -----------------------------------------------------------------------------\r\n"
    "  In port 0/ 2/1 , the total of ONTs are: 2, online: 1\r\n"
    "  -----------------------------------------------------------------------------\r\n"
    "\r\nlab-olt#"
)
EMPTY_REPLY = "display ont info 0 2 1 all\r\n  No ONT is configured\r\n\r\nlab-olt#"
UNPARSED_REPLY = (
    "display ont info 0 2 1 all\r\n"
    "  F/S/P   ONT         SN         Control     Run      Config   Match    Protect\r\n"
    "  0/ 2/1     0  4857544300000001  active      online\r\n"
    "\r\nlab-olt#"
)
PARAMETER_ERROR_REPLY = (
    "display ont info 0 2 1 all\r\n  % Parameter error, the error locates at '^'\r\n"
    "\r\nlab-olt#"
)
VERSION_REPLY = (
    "display version\r\n"
    "  VERSION : MA5608V800R013C00\r\n"
    "  PRODUCT : MA5608T\r\n"
    "\r\nlab-olt#"
)
LOGOUT_REPLIES = {
    "quit\n": "quit\r\nAre you sure to log out? (y/n)[n]:",
}


class _Rig:
    """A fake OLT behind Sub's REAL ``_manage_transport`` / ``_instrument_channel``.

    The legacy close path is genuinely armed: if the package path let it run too,
    a second ``quit`` sequence would show up in ``channel.sent``.
    """

    def __init__(self, monkeypatch, replies: dict[str, str]) -> None:
        self.clock = FakeClock()
        self.channel = ReplayChannel(
            self.clock,
            replies={**LOGOUT_REPLIES, **replies},
            eof_after_answer=True,
        )
        olt_ssh._instrument_channel(self.channel)
        self.opens = 0
        self.original_close_calls = 0
        self.close_real_calls = 0
        self.releases = 0
        self.logouts: list[str] = []
        rig = self

        class _Transport:
            def close(self) -> None:  # becomes the raw paramiko close
                rig.original_close_calls += 1

            def is_active(self) -> bool:
                return True

        self.transport = _Transport()
        lease = SimpleNamespace(wait_seconds=0.0)
        monkeypatch.setattr(
            olt_ssh_limiter,
            "mark_released",
            lambda _lease: setattr(rig, "releases", rig.releases + 1),
        )
        olt_ssh._manage_transport(
            self.transport,
            lease=lease,
            logout_on_close=True,
            grace_seconds=0,
            olt_label="OLT-A",
            priority="background",
            opened_at=0.0,
        )
        olt_ssh._attach_channel(self.transport, self.channel)
        real_close_real = self.transport.close_real

        def counting_close_real() -> None:
            rig.close_real_calls += 1
            real_close_real()

        self.transport.close_real = counting_close_real
        monkeypatch.setattr(
            olt_ssh_metrics,
            "record_logout",
            lambda outcome: rig.logouts.append(outcome),
        )

        def open_shell(_olt: Any) -> Any:
            rig.opens += 1
            return rig.transport, rig.channel, SimpleNamespace(prompt_regex=r"#\s*$")

        monkeypatch.setattr(olt_ssh, "_open_shell", open_shell)
        self.reads: list[tuple[str, str, str, str]] = []
        monkeypatch.setattr(
            olt_ssh_metrics,
            "record_device_cli_read",
            lambda olt, op, result, reason="": rig.reads.append(
                (olt, op, result, reason)
            ),
        )
        monkeypatch.setattr(olt_ssh_metrics, "_incr", lambda *a, **k: None)

    @property
    def quits(self) -> int:
        return self.channel.sent.count("quit\n")

    def assert_closed_exactly_once(self) -> None:
        assert self.original_close_calls == 1
        assert self.close_real_calls == 1
        assert self.releases == 1  # slot released once
        assert len(self.logouts) == 1  # olt_ssh_logout recorded once
        # A late caller-side transport.close() must be a no-op (no 2nd quit).
        before = list(self.channel.sent)
        self.transport.close()
        assert self.channel.sent == before
        assert self.original_close_calls == 1 and self.releases == 1
        assert len(self.logouts) == 1


@pytest.fixture
def rig_factory(monkeypatch):
    def make(replies: dict[str, str]) -> _Rig:
        return _Rig(monkeypatch, replies)

    return make


def _forget_host(monkeypatch) -> None:
    """Make the next ``import device_cli_host`` re-execute the module."""
    import app.services.network as network_pkg

    monkeypatch.delitem(
        sys.modules, "app.services.network.device_cli_host", raising=False
    )
    monkeypatch.delattr(network_pkg, "device_cli_host", raising=False)


def _legacy_reader(monkeypatch) -> None:
    monkeypatch.setattr(olt_ssh, "_prepare_huawei_read_shell", lambda *a, **k: "#")
    monkeypatch.setattr(
        olt_ssh, "_run_huawei_paged_cmd", lambda *a, **k: "No ONT is configured\nx#"
    )


def test_flag_off_runs_legacy_and_never_imports_the_host(
    monkeypatch, rig_factory
) -> None:
    rig = rig_factory({})
    olt = _olt()
    _legacy_reader(monkeypatch)
    # Poison the package AND the host: flag-off must not even look at them.
    monkeypatch.setitem(sys.modules, "dotmac_device_cli", None)
    _forget_host(monkeypatch)
    gate.set_read_settings_override(gate.DeviceCliReadSettings())
    ok, message, entries = get_registered_ont_serials(olt, ["0/2/1"])
    assert (ok, entries) == (True, [])
    assert message == "Found 0 registered ONTs on 1 ports"
    assert rig.opens == 1  # one legacy login
    assert "app.services.network.device_cli_host" not in sys.modules


