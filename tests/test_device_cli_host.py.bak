"""Host adapters for ``dotmac-device-cli`` (PR-S1): goldens, adapters, wiring.

Everything here runs without a database or a device: the package's own test
doubles (``ReplayChannel``, ``FakeClock``) stand in for the OLT and Sub's
in-memory advisory-lock server stands in for PostgreSQL. Hosts and addresses are
documentation values.

The cross-engine slot-sharing proof against real PostgreSQL lives in
``tests/integration/test_device_cli_slot_sharing.py``.
"""

from __future__ import annotations

import importlib
import socket
import sys
import threading
import uuid
from types import SimpleNamespace
from typing import Any

import pytest
from dotmac_device_cli import (
    DeviceBusy,
    NoProfile,
    Reason,
    builtin_registry,
)
from dotmac_device_cli import intent_key as package_intent_key
from dotmac_device_cli import slot_key as package_slot_key
from dotmac_device_cli.testing import FakeClock, ReplayChannel

from app.services.network import (
    device_cli_gate as gate,
)
from app.services.network import (
    device_cli_host,
    olt_ssh,
    olt_ssh_limiter,
    olt_ssh_metrics,
)
from app.services.network.olt_ssh_limiter import (
    LimiterConfig,
    OltSessionBusy,
    OltSshPriority,
    set_config_override,
)
from app.services.network.olt_ssh_ont.status import get_registered_ont_serials

# ── lock-key goldens ─────────────────────────────────────────────────────────
# KEEP IN SYNC WITH STARTER. These vectors are the ones pinned by
# dotmac-device-cli 0.1.0a1 (tests/unit/test_device_cli_limiter.py) and were
# computed with the derivation in ``olt_ssh_limiter._signed_key`` (blake2b, 8-byte
# digest, big-endian, signed). Sub had no pinned vectors before this PR, so a
# drift here was previously undetectable. They are asserted against BOTH engines:
# if either side changes its derivation the two stop sharing slots in the shared
# database and briefly allow twice the sessions.
SLOT_VECTORS = {
    "00000000-0000-4000-8000-000000000001": (
        -3148890172339245725,
        -9068375865187576960,
        -1039721830728024854,
    ),
    "lab-olt": (-8678444213299380193, 1909821310459583165, -318973743125864412),
    "203.0.113.7-test": (
        8375931043202659789,
        -4874932496492983623,
        -647553131079769680,
    ),
}
INTENT_VECTORS = {
    "00000000-0000-4000-8000-000000000001": -7864250139092424918,
    "lab-olt": 1790200665425164038,
    "203.0.113.7-test": -4163376672186175071,
}


@pytest.mark.parametrize("key", sorted(SLOT_VECTORS))
def test_sub_limiter_keys_match_the_pinned_vectors(key: str) -> None:
    assert (
        tuple(olt_ssh_limiter.slot_key(key, i) for i in range(3)) == SLOT_VECTORS[key]
    )
    assert olt_ssh_limiter.intent_key(key) == INTENT_VECTORS[key]


@pytest.mark.parametrize("key", sorted(SLOT_VECTORS))
def test_package_limiter_keys_match_the_same_vectors(key: str) -> None:
    assert tuple(package_slot_key(key, i) for i in range(3)) == SLOT_VECTORS[key]
    assert package_intent_key(key) == INTENT_VECTORS[key]


def test_the_device_key_is_the_olt_id_and_never_the_name() -> None:
    olt_id = uuid.uuid4()
    assert device_cli_host.device_key_for(SimpleNamespace(id=olt_id, name="x")) == str(
        olt_id
    )
    for empty in (None, "", 0):
        with pytest.raises(ValueError):
            device_cli_host.device_key_for(SimpleNamespace(id=empty, name="by-name"))


# ── fakes ────────────────────────────────────────────────────────────────────

PG_URL = "postgresql+psycopg://user:pw@db.invalid:5432/example"  # documentation host


class _Result:
    def __init__(self, value: object) -> None:
        self._value = value

    def scalar(self) -> object:
        return self._value


class FakeLockServer:
    """In-memory advisory locks with PostgreSQL session semantics."""

    def __init__(self) -> None:
        self.mutex = threading.Lock()
        self.exclusive: dict[int, int] = {}
        self.shared: dict[int, set[int]] = {}
        self.next_conn = 0
        self.statements: list[str] = []

    def connect(self) -> FakeConn:
        with self.mutex:
            self.next_conn += 1
            return FakeConn(self, self.next_conn)


class FakeConn:
    def __init__(self, server: FakeLockServer, ident: int) -> None:
        self.server = server
        self.ident = ident
        self.closed = False
        self.invalidated = False

    def execute(self, statement: object, params: dict[str, int]) -> _Result:
        sql = str(statement)
        key = params["key"]
        s = self.server
        with s.mutex:
            s.statements.append(sql)
            if "pg_try_advisory_lock_shared" in sql:
                owner = s.exclusive.get(key)
                if owner is not None and owner != self.ident:
                    return _Result(False)
                s.shared.setdefault(key, set()).add(self.ident)
                return _Result(True)
            if "pg_try_advisory_lock" in sql:
                owner = s.exclusive.get(key)
                others = s.shared.get(key, set()) - {self.ident}
                if (owner is not None and owner != self.ident) or others:
                    return _Result(False)
                s.exclusive[key] = self.ident
                return _Result(True)
            if "pg_advisory_unlock_shared" in sql:
                held = self.ident in s.shared.get(key, set())
                s.shared.get(key, set()).discard(self.ident)
                return _Result(held)
            if "pg_advisory_unlock" in sql:
                if s.exclusive.get(key) == self.ident:
                    del s.exclusive[key]
                    return _Result(True)
                return _Result(False)
        raise AssertionError(f"unexpected SQL: {sql}")

    def invalidate(self) -> None:
        self.invalidated = True
        self._free()

    def close(self) -> None:
        self._free()

    def _free(self) -> None:
        if self.closed:
            return
        self.closed = True
        with self.server.mutex:
            for key in [k for k, v in self.server.exclusive.items() if v == self.ident]:
                del self.server.exclusive[key]
            for holders in self.server.shared.values():
                holders.discard(self.ident)


@pytest.fixture
def server(monkeypatch) -> FakeLockServer:
    fake = FakeLockServer()
    monkeypatch.setattr(
        olt_ssh_limiter,
        "_limiter_engine",
        lambda url: SimpleNamespace(connect=fake.connect),
    )
    monkeypatch.setattr(olt_ssh_limiter, "_database_url", lambda: PG_URL)
    set_config_override(LimiterConfig())
    yield fake
    set_config_override(None)


PROFILE_56 = builtin_registry().get("huawei-ma5608t-v800r013")
PROFILE_58 = builtin_registry().get("huawei-ma5800-x2-v100r019")
assert PROFILE_56 is not None and PROFILE_58 is not None


def _olt(
    *,
    model: str = "MA5608T",
    firmware: str | None = "V800R013C00",
    active: bool | None = True,
    olt_id: object | None = None,
    name: str = "OLT-A",
    vendor: str = "Huawei",
) -> Any:
    return SimpleNamespace(
        id=uuid.uuid4() if olt_id is None else olt_id,
        name=name,
        vendor=vendor,
        model=model,
        firmware_version=firmware,
        software_version=None,
        is_active=active,
    )


# ── lock-store adapter ───────────────────────────────────────────────────────


def test_pg_store_runs_the_same_four_statements_as_the_legacy_limiter(server) -> None:
    store = device_cli_host.PgAdvisoryLockStore(server.connect())
    assert store.try_lock(7) is True
    assert store.try_lock_shared(8) is True
    store.unlock(7)
    store.unlock_shared(8)
    assert [
        s.split("(")[0].strip().removeprefix("SELECT ") for s in server.statements
    ] == [
        "pg_try_advisory_lock",
        "pg_try_advisory_lock_shared",
        "pg_advisory_unlock",
        "pg_advisory_unlock_shared",
    ]


def test_pg_store_close_invalidates_so_locks_free_even_if_unlock_failed(server) -> None:
    conn = server.connect()
    store = device_cli_host.PgAdvisoryLockStore(conn)
    assert store.try_lock(11)
    store.close()  # no explicit unlock
    assert conn.invalidated and conn.closed
    assert server.exclusive == {}
    store.close()  # idempotent
    with pytest.raises(RuntimeError):  # a closed store never silently no-ops
        store.try_lock(11)


def test_there_is_no_null_lane_on_a_non_postgres_url() -> None:
    factory = device_cli_host.pg_store_factory("sqlite:///:memory:")
    with pytest.raises(RuntimeError):
        factory()


def test_a_store_that_cannot_connect_fails_closed_as_busy() -> None:
    from dotmac_device_cli import Priority
    from dotmac_device_cli import acquire_slot as package_acquire_slot
    from dotmac_device_cli.testing import FakeClock as Clock

    def broken() -> Any:
        raise RuntimeError("database unavailable")

    with pytest.raises(DeviceBusy) as exc:
        package_acquire_slot(
            broken,
            device_key="lab-olt",
            limit=2,
            reserved=1,
            priority=Priority.BACKGROUND,
            wait_seconds=0,
            clock=Clock(),
        )
    assert olt_ssh_limiter.is_busy_message(str(exc.value))


def test_package_slot_makes_the_legacy_limiter_see_it_taken(server) -> None:
    olt = _olt()
    lease = device_cli_host.acquire_device_slot(
        olt,
        PROFILE_56,
        priority=OltSshPriority.BACKGROUND,
        store_factory=lambda: device_cli_host.PgAdvisoryLockStore(server.connect()),
    )
    assert lease.slot_index == 0
    with pytest.raises(OltSessionBusy):
        olt_ssh_limiter.acquire_slot(
            olt_key=str(olt.id),
            limit=2,
            reserved=1,
            priority=OltSshPriority.BACKGROUND,
            wait_seconds=0,
        )
    lease.release()
    legacy = olt_ssh_limiter.acquire_slot(
        olt_key=str(olt.id),
        limit=2,
        reserved=1,
        priority=OltSshPriority.BACKGROUND,
        wait_seconds=0,
    )
    legacy.release()


def test_legacy_slot_makes_the_package_see_it_taken(server) -> None:
    olt = _olt()
    legacy = olt_ssh_limiter.acquire_slot(
        olt_key=str(olt.id),
        limit=2,
        reserved=1,
        priority=OltSshPriority.BACKGROUND,
        wait_seconds=0,
    )
    with pytest.raises(DeviceBusy) as exc:
        device_cli_host.acquire_device_slot(
            olt,
            PROFILE_56,
            priority=OltSshPriority.BACKGROUND,
            store_factory=lambda: device_cli_host.PgAdvisoryLockStore(server.connect()),
        )
    assert olt_ssh_limiter.is_busy_message(str(exc.value))
    legacy.release()


def test_settings_can_only_lower_the_profile_slot_count(server, monkeypatch) -> None:
    captured: dict[str, Any] = {}

    def fake_acquire(factory, **kwargs):
        captured.update(kwargs)
        return "lease"

    monkeypatch.setattr(device_cli_host, "package_acquire_slot", fake_acquire)
    factory = lambda: device_cli_host.PgAdvisoryLockStore(server.connect())  # noqa: E731

    # Profile caps MA5608T at 2: a raised Sub setting never raises it.
    set_config_override(LimiterConfig(max_ma5608t=8))
    device_cli_host.acquire_device_slot(
        _olt(), PROFILE_56, priority=OltSshPriority.BACKGROUND, store_factory=factory
    )
    assert captured["limit"] == 2

    # A lowered Sub setting wins.
    set_config_override(LimiterConfig(max_ma5608t=1))
    device_cli_host.acquire_device_slot(
        _olt(), PROFILE_56, priority=OltSshPriority.BACKGROUND, store_factory=factory
    )
    assert captured["limit"] == 1 and captured["reserved"] == 0


def test_empty_olt_id_is_refused_before_any_lock_is_taken(server) -> None:
    with pytest.raises(ValueError):
        device_cli_host.acquire_device_slot(
            _olt(olt_id=""),
            PROFILE_56,
            store_factory=lambda: device_cli_host.PgAdvisoryLockStore(server.connect()),
        )
    assert server.statements == []


# ── channel adapter ──────────────────────────────────────────────────────────


class _RawChannel:
    def __init__(self, chunks: list[Any]) -> None:
        self.chunks = chunks
        self.sent: list[str] = []
        self.timeout: float | None = None
        self.closed = False

    def send(self, data: str) -> None:  # paramiko may return a count; fakes may not
        self.sent.append(data)

    def recv(self, nbytes: int) -> Any:
        item = self.chunks.pop(0)
        if isinstance(item, BaseException):
            raise item
        return item

    def recv_ready(self) -> bool:
        return bool(self.chunks)

    def settimeout(self, seconds: float) -> None:
        self.timeout = seconds


def test_channel_surfaces_idle_as_timeout_and_passes_bytes_and_eof() -> None:
    assert socket.timeout is TimeoutError  # the alias the adapter relies on
    raw = _RawChannel([TimeoutError("timed out"), b"abc", "txt", b""])
    channel = device_cli_host.ParamikoShellChannel(raw)
    with pytest.raises(TimeoutError):
        channel.recv(4096)
    assert channel.recv(4096) == b"abc"
    assert channel.recv(4096) == b"txt"
    assert channel.recv(4096) == b""  # EOF stays b""
    assert channel.send("x\n") == 2 and raw.sent == ["x\n"]
    channel.settimeout(0.5)
    assert raw.timeout == 0.5
    assert channel.closed is False
    raw.closed = True
    assert channel.closed is True


# ── profile resolution ───────────────────────────────────────────────────────


@pytest.mark.parametrize(
    ("model", "firmware", "expected"),
    [
        ("MA5608T", "V800R013C00", "huawei-ma5608t-v800r013"),
        ("MA5800-X2", "V100R019C10", "huawei-ma5800-x2-v100r019"),
        ("MA5608T", "V800R015C00", None),  # home-gateway train: no layer yet
        ("MA5608T", "V800R018C10", None),
        ("MA5800-X2", "V800R019C00", None),
        ("MA5800-X2", "V100R020C00", None),
        ("MA5600T", "V800R011C00", None),  # Sub has an SSH policy; no package profile
        ("MA5683T", "V800R013C00", None),
        ("MA5608T", None, None),
        ("MA5608T", "", None),
    ],
)
def test_each_registry_firmware_resolves_to_a_profile_or_nothing(
    model: str, firmware: str | None, expected: str | None
) -> None:
    resolved = device_cli_host.resolve_profile(_olt(model=model, firmware=firmware))
    if expected is None:
        assert isinstance(resolved, NoProfile)
    else:
        assert resolved.id == expected


def test_only_the_configured_vendor_resolves() -> None:
    assert isinstance(
        device_cli_host.resolve_profile(_olt(vendor="ZTE", model="C300")), NoProfile
    )
    assert isinstance(
        device_cli_host.resolve_profile(_olt(vendor="", model="MA5608T")), NoProfile
    )


def test_firmware_falls_back_to_software_version() -> None:
    olt = _olt(firmware=None)
    olt.software_version = "V800R013C00"
    assert device_cli_host.resolve_profile(olt).id == "huawei-ma5608t-v800r013"


@pytest.mark.parametrize(
    ("model", "firmware"),
    [("MA5608T", "V800R013C00"), ("MA5800-X2", "V100R019C10")],
)
def test_profile_ssh_data_agrees_with_the_legacy_ssh_policy(
    model: str, firmware: str
) -> None:
    """Drift between the package profile and OltSshPolicy is a test failure."""
    olt = _olt(model=model, firmware=firmware)
    profile = device_cli_host.resolve_profile(olt)
    assert (
        device_cli_host.ssh_policy_mismatch(profile, olt_ssh.resolve_policy(olt))
        is None
    )


def test_ssh_policy_drift_is_reported() -> None:
    policy = olt_ssh.resolve_policy(_olt())
    from dataclasses import replace

    drifted = replace(policy, ciphers=("aes256-ctr",))
    assert (
        device_cli_host.ssh_policy_mismatch(PROFILE_56, drifted) == "ssh ciphers differ"
    )


def test_ma5608t_inventory_command_is_byte_identical_to_legacy() -> None:
    olt = _olt()
    for fsp in ("0/2/1", "0/1/12"):
        assert device_cli_host.package_inventory_command(
            PROFILE_56, fsp
        ) == device_cli_host.legacy_inventory_command(olt, fsp)


def test_ma5800_inventory_command_differs_from_legacy_so_it_stays_legacy() -> None:
    """Legacy polls MA5800 with ``summary``; the package renders the ``all`` form.

    That grammar question is settled (with transcripts) in a later Starter PR.
    Until then the host must refuse to run it, whatever the flags say.
    """
    olt = _olt(model="MA5800-X2", firmware="V100R019C10")
    assert device_cli_host.package_inventory_command(
        PROFILE_58, "0/2/1"
    ) != device_cli_host.legacy_inventory_command(olt, "0/2/1")


