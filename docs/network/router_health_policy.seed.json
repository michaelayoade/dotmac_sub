{
  "version": 1,
  "defaults": {
    "role": "access",
    "snmp_allowed_sources": [
      "192.0.2.1/32",
      "192.0.2.2/32",
      "192.0.2.3/32",
      "192.0.2.4/32"
    ],
    "input_v4": {
      "mode": "enforce",
      "accept_comment_prefix": "INPUT-PROTECT:",
      "final_drop_comment_regex": "(?i)^INPUT-PROTECT: drop all else$",
      "min_accepts": 8
    },
    "input_v6": {
      "mode": "observe",
      "accept_comment_prefix": "INPUT6-PROTECT:",
      "final_drop_comment_regex": "(?i)^INPUT6-PROTECT: drop all else$",
      "min_accepts": 4
    },
    "suspension_target_chains": [
      "dotmac-suspended",
      "dotmac-wg"
    ],
    "reverse_proxy_min_ros": "7.22",
    "ops_user": {
      "name": "dotmac-ops",
      "group": "read",
      "required_address": "192.0.2.3"
    },
    "rest_user": {
      "name": "snap-api",
      "forbidden_groups": [
        "full"
      ]
    },
    "report_unrestricted_full_users": true
  },
  "roles": {
    "access": {
      "checks_off": []
    },
    "core": {
      "checks_off": [
        "suspension-jump",
        "suspension-chain",
        "radius-incoming",
        "ppp-drop",
        "coa-canary"
      ]
    },
    "border": {
      "checks_off": [
        "suspension-jump",
        "suspension-chain",
        "radius-incoming",
        "ppp-drop",
        "coa-canary"
      ]
    }
  },
  "routers": [
    {
      "match": {
        "identity": "Abuja DOTMAC-GBB"
      },
      "role": "border",
      "role_reason": "eBGP border router",
      "input_v4": {
        "mode": "observe",
        "until": "2026-10-18",
        "reason": "IPv4 Phase A 7-day border observe; border decision due 2026-10-18"
      },
      "input_v6": {
        "mode": "exempt",
        "until": "2026-11-15",
        "reason": "borders last: 7-day observe after the 2026-10-18 v4 decision"
      },
      "exceptions": [
        {
          "check": "bgp-session-down",
          "scope": "192.0.2.93",
          "until": "2026-11-12",
          "reason": "Airport site retired 2026-10-12; disabled BGP left in place (replace scope with the real peer address when applying)"
        }
