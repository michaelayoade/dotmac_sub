{
  "version": 1,
  "defaults": {
    "role": "access",
    "snmp_allowed_sources": [
      "192.0.2.1/32",
      "192.0.2.2/32",
      "192.0.2.3/32",
      "192.0.2.4/32"
    ],
    "input_v4": {
      "mode": "enforce",
      "accept_comment_prefix": "INPUT-PROTECT:",
      "final_drop_comment_regex": "(?i)^INPUT-PROTECT: drop all else$",
      "min_accepts": 8
    },
    "input_v6": {
      "mode": "observe",
      "accept_comment_prefix": "INPUT6-PROTECT:",
      "final_drop_comment_regex": "(?i)^INPUT6-PROTECT: drop all else$",
      "min_accepts": 4
    },
    "suspension_target_chains": [
      "dotmac-suspended",
      "dotmac-wg"
    ],
    "reverse_proxy_min_ros": "7.22",
    "ops_user": {
      "name": "dotmac-ops",
      "group": "read",
      "required_address": "192.0.2.3"
    },
    "rest_user": {
      "name": "snap-api",
      "forbidden_groups": [
        "full"
      ]
    },
    "report_unrestricted_full_users": true
  },
  "roles": {
    "access": {
      "checks_off": []
    },
    "core": {
      "checks_off": [
        "suspension-jump",
        "suspension-chain",
        "radius-incoming",
        "ppp-drop",
        "coa-canary"
      ]
    },
    "border": {
      "checks_off": [
        "suspension-jump",
        "suspension-chain",
        "radius-incoming",
        "ppp-drop",
        "coa-canary"
      ]
    }
  },
  "routers": [
    {
      "match": {
        "identity": "border-a"
      },
      "role": "border",
      "role_reason": "example eBGP border router",
      "input_v4": {
        "mode": "observe",
        "until": "2026-12-01",
        "reason": "example border observe window"
      },
      "input_v6": {
        "mode": "exempt",
        "until": "2026-12-15",
        "reason": "example: borders last"
      },
      "exceptions": [
        {
          "check": "bgp-session-down",
          "scope": "198.51.100.10",
          "until": "2026-12-15",
          "reason": "example: retired peer, disabled BGP left in place"
        }
      ]
    },
    {
      "match": {
        "identity": "border-b"
      },
      "role": "border",
      "role_reason": "example eBGP border router",
      "input_v4": {
        "mode": "enforce",
        "reason": "example: pre-existing chain matches the default drop regex"
      }
    },
    {
      "match": {
        "identity": "core-a"
      },
      "role": "core",
      "role_reason": "example iBGP core router",
      "input_v6": {
        "mode": "custom",
        "accept_comment_prefix": "V6-INPUT:",
        "final_drop_comment_regex": "(?i)^V6-INPUT: drop all else$",
        "permanent": true,
        "reason": "example: pre-existing custom v6 rule set"
      }
    },
    {
      "match": {
        "identity": "access-a"
      },
      "input_v6": {
        "mode": "observe",
        "until": "2026-12-01",
        "reason": "example observe window"
      },
      "annotations": [
        {
          "check": "coa-canary",
          "note": "example annotation: firmware does not transmit CoA replies"
        }
      ]
    },
    {
      "match": {
        "identity": "access-b"
      },
      "input_v6": {
        "mode": "exempt",
        "until": "2026-12-15",
        "reason": "example: v6 pending"
      }
    },
    {
      "match": {
        "router_name": "access-c"
      },
      "input_v4": {
        "mode": "exempt",
        "until": "2026-12-15",
        "reason": "example: unreachable"
      },
      "input_v6": {
        "mode": "exempt",
        "until": "2026-12-15",
        "reason": "example: unreachable"
      }
    }
  ]
}
