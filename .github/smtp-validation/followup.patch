diff --git a/tests/test_smtp_sender_credentials.py b/tests/test_smtp_sender_credentials.py
index add01d257..8d3c66b5b 100644
--- a/tests/test_smtp_sender_credentials.py
+++ b/tests/test_smtp_sender_credentials.py
@@ -506,3 +506,40 @@ def test_bad_sender_does_not_block_other_queued_email(
     assert second.status == NotificationStatus.delivered
     assert result["delivered"] == 1
     assert smtp.logins == [("support@example.test", "support-synthetic-credential")]
+
+
+@pytest.mark.parametrize("selected_config", [False, True])
+def test_send_auth_failure_never_logs_provider_credential_echo(
+    db_session: Session,
+    smtp: RecordingSMTP,
+    monkeypatch: pytest.MonkeyPatch,
+    caplog: pytest.LogCaptureFixture,
+    selected_config: bool,
+) -> None:
+    _sender(db_session)
+
+    def reject(_username: str, _password: str) -> tuple[int, bytes]:
+        raise smtplib.SMTPAuthenticationError(535, PASSWORD.encode())
+
+    monkeypatch.setattr(smtp, "login", reject)
+    if selected_config:
+        config = email_service.get_smtp_config(db_session, sender_key="finance")
+        sent = email_service.send_email_with_config(
+            config=config,
+            to_email="test@example.test",
+            subject="Test only",
+            body_html="<p>Test only</p>",
+        )
+    else:
+        sent = email_service.send_email(
+            db=db_session,
+            to_email="test@example.test",
+            subject="Test only",
+            body_html="<p>Test only</p>",
+            sender_key="finance",
+            track=False,
+        )
+    assert sent is False
+    assert PASSWORD not in caplog.text
+    assert "code=535" in caplog.text
+    assert smtp.messages == []
