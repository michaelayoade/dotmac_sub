[Unit]
Description=Dotmac published-port rollback deadman for %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/dotmac-published-port-deadman check --operation %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dotmac/published-port-reconcile /var/lock
# The deployment .env and Docker socket are host-specific. The installer adds
# their exact paths through a per-operation drop-in before arming the timer.
