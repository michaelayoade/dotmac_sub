  "bound_issuer": "https://token.actions.githubusercontent.com",
  "default_role": "",
  "roles": {
    "sub-staging-ci": {
      "role_type": "jwt",
      "user_claim": "sub",
      "bound_audiences": ["dotmac-openbao"],
      "bound_subject": "repo:michaelayoade/dotmac_sub:environment:staging",
      "bound_claims_type": "glob",
      "bound_claims": {
        "repository": ["michaelayoade/dotmac_sub"],
        "repository_owner": ["michaelayoade"],
        "repository_id": ["1163746040"],
        "repository_owner_id": ["32591929"],
