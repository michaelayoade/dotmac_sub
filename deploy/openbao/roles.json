        "environment": ["staging"],
        "job_workflow_ref": ["michaelayoade/dotmac_sub/.github/workflows/staging-deploy.yml@refs/heads/main"]
      },
      "token_policies": ["sub-staging-ci"],
      "token_ttl": "20m",
      "token_max_ttl": "60m"
    },
    "sub-production-ci": {
